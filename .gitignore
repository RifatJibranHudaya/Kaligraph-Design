```gitignore
# Compiled and build artifacts
*.pyc
__pycache__/

# Dependencies
vendor/
node_modules/
composer.lock

# Logs and temp files
*.log
*.tmp

# Environment
.env
.env.local
.env.*

# Editors
.vscode/
.idea/

# OS generated files
.DS_Store
Thumbs.db

# Build and distribution
build/
dist/
target/

# Cache directories
.cache/
.php_cs.cache

# Coverage reports
coverage/
htmlcov/

# Storage and bootstrap cache
/storage/
/bootstrap/cache/

# Legacy files
.svn/
 CVS/
```